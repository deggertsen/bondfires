{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    }
  },
  "scripts": {
    "eas-build-pre-install": "corepack enable && corepack prepare yarn@4.12.0 --activate",
    "start": "expo start",
    "dev": "expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "android:start": "expo start --android",
    "ios:start": "expo start --ios",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "web": "expo start --web",
    "build": "echo 'Use EAS Build for production builds'",
    "build:android:dev": "eas build --platform android --profile development",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:dev:sim": "eas build --platform ios --profile development-simulator",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production --local",
    "build:android:prod": "eas build --platform android --profile production --local",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "release:ios": "yarn build:ios:prod && yarn submit:ios",
    "release:android": "yarn build:android:prod && yarn submit:android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "~0.41.3",
    "@bacons/apple-targets": "4.0.7",
    "@bondfires/app": "workspace:*",
    "@bondfires/config": "workspace:*",
    "@bondfires/ui": "workspace:*",
    "@convex-dev/auth": "^0.0.95",
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/state": "3.0.0-beta.48",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@tamagui/animations-react-native": "^1.144.4",
    "@tamagui/babel-plugin": "^1.144.4",
    "@tamagui/config": "^1.144.4",
    "@tamagui/font-inter": "^1.144.4",
    "@tamagui/lucide-icons": "^1.144.4",
    "@tamagui/metro-plugin": "^1.144.4",
    "@tamagui/shorthands": "^1.144.4",
    "@tamagui/themes": "^1.144.4",
    "convex": "^1.45.0",
    "expo": "~54.0.37",
    "expo-background-fetch": "~14.0.9",
    "expo-camera": "^17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "^8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-iap": "^4.7.2",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-in-app-updates": "^0.12.0",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "patch:expo-video@npm%3A3.0.16#~/.yarn/patches/expo-video-npm-3.0.16-8037695497.patch",
    "expo-web-browser": "~15.0.11",
    "mux-embed": "5.18.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-compressor": "^1.19.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "tamagui": "^1.144.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "expo-build-properties": "^1.0.10",
    "react-refresh": "0.14.2",
    "react-test-renderer": "19.1.0",
    "typescript": "^6.0.0"
  },
  "private": true
}
