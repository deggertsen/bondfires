{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    }
  },
  "scripts": {
    "eas-build-pre-install": "corepack enable && corepack prepare yarn@4.12.0 --activate",
    "start": "expo start",
    "dev": "expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "android:start": "expo start --android",
    "ios:start": "expo start --ios",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "web": "expo start --web",
    "build": "echo 'Use EAS Build for production builds'",
    "build:android:dev": "eas build --platform android --profile development",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:dev:sim": "eas build --platform ios --profile development-simulator",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production --local",
    "build:android:prod": "eas build --platform android --profile production --local",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "release:ios": "yarn build:ios:prod && yarn submit:ios",
    "release:android": "yarn build:android:prod && yarn submit:android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "~0.41.3",
    "@bacons/apple-targets": "4.0.7",
    "@bondfires/app": "workspace:*",
    "@bondfires/config": "workspace:*",
    "@bondfires/ui": "workspace:*",
    "@convex-dev/auth": "^0.0.95",
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/state": "3.0.0-beta.48",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@tamagui/animations-react-native": "^1.144.4",
    "@tamagui/babel-plugin": "^1.144.4",
    "@tamagui/config": "^1.144.4",
    "@tamagui/font-inter": "^1.144.4",
    "@tamagui/lucide-icons": "^1.144.4",
    "@tamagui/metro-plugin": "^1.144.4",
    "@tamagui/shorthands": "^1.144.4",
    "@tamagui/themes": "^1.144.4",
    "convex": "^1.45.0",
    "expo": "~58.0.25",
    "expo-background-fetch": "~58.0.13",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-iap": "patch:expo-iap@npm%3A4.7.2#~/.yarn/patches/expo-iap-npm-4.7.2.patch",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-in-app-updates": "^0.12.0",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "expo-video": "patch:expo-video@npm%3A~58.0.14#~/.yarn/patches/expo-video-npm-58.0.14.patch",
    "expo-web-browser": "~58.0.8",
    "promise": "8.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-compressor": "^1.19.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tamagui": "^1.144.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "react-refresh": "0.14.2",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.0"
  },
  "private": true
}
